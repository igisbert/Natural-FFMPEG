{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "opener:default",
    "store:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-delete",
    "store:allow-save",
    "store:allow-has",
    "shell:default",
    "dialog:default",
    "clipboard-manager:default",
    "clipboard-manager:allow-write-text",
    "core:path:default",
    "notification:default"
  ]
}